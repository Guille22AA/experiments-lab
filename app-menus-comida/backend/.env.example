# Copy this file to `.env` and fill in your values. `.env` is ignored by git.

# --- Server ---
# Port where the API listens.
PORT=3001
# 127.0.0.1 = only this PC can reach the API (recommended: in development the
# phone talks to Vite, and Vite forwards /api here). Use 0.0.0.0 only when the
# backend itself must be reachable from other devices (e.g. serving the built app).
HOST=127.0.0.1
# SQLite database file (relative to the backend folder).
DB_PATH=./data/app.db

# --- Access ---
# The app asks for a password (created the first time it is opened).
# Only set to false for local demos: without it anyone who reaches the app can use it.
AUTH_REQUIRED=true
# Days a device stays logged in.
SESSION_DAYS=90
# Set to true when the app is served over HTTPS (on the internet).
COOKIE_SECURE=false
# Set to true behind a reverse proxy (Caddy, Nginx) so the login attempt limit sees the real IP.
TRUST_PROXY=false

# --- AI provider ---
# Which provider the aiService uses. Available: gemini
# (planned: claude, groq, ollama — see src/ai/providers/).
AI_PROVIDER=gemini
# Model name for that provider. `gemini-flash-latest` always points to the
# newest Flash model (free tier, reads images and PDFs).
AI_MODEL=gemini-flash-latest
# Model for the automatic retry when the main one is overloaded ("high demand").
# Leave empty to retry with the same model.
AI_FALLBACK_MODEL=gemini-flash-lite-latest
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
